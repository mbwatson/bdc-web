---
import { getCollection } from 'astro:content';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

type NavItem = {
  label: string;
  href?: string;
  exact?: boolean;
  children?: NavItem[];
};

const meetings = await getCollection('meetings');
const rfcs = await getCollection('rfcs');

const KIND_LABEL: Record<'quarterly' | 'bams', string> = {
  quarterly: 'Quarterly Meetings',
  bams: 'Bi-Annual Meetings',
};

// Group meetings by year-slug (the first path segment of the entry id).
const byYear = new Map<string, typeof meetings>();
for (const m of meetings) {
  const yearSlug = m.id.split('/')[0];
  if (!byYear.has(yearSlug)) byYear.set(yearSlug, []);
  byYear.get(yearSlug)!.push(m);
}

const meetingMaterialsChildren: NavItem[] = [...byYear.entries()]
  .sort(([a], [b]) => b.localeCompare(a)) // newest year first
  .map(([yearSlug, entries]) => {
    const year = yearSlug.match(/^\d{4}/)?.[0] ?? yearSlug;
    const kind = entries[0].data.kind;
    return {
      label: `${year} ${KIND_LABEL[kind]}`,
      children: entries
        .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
        .map((m) => ({
          label: m.data.title,
          href: `/consortium-resources/meeting-materials/${m.id}`,
        })),
    };
  });

const rfcChildren: NavItem[] = rfcs
  .sort((a, b) => a.data.order - b.data.order)
  .map((rfc) => ({
    label: rfc.data.title,
    href: `/consortium-resources/rfcs/${rfc.id}`,
  }));

const nav: NavItem[] = [
  {
    label: 'Consortium Resources',
    href: '/consortium-resources',
    exact: true,
  },
  {
    label: 'Meeting Materials',
    href: '/consortium-resources/meeting-materials',
    children: meetingMaterialsChildren,
  },
  {
    label: 'RFCs',
    href: '/consortium-resources/rfcs',
    children: rfcChildren.length > 0 ? rfcChildren : undefined,
  },
  {
    label: 'Consortium New Member Form',
    href: '/consortium-resources/new-member-form-page',
  },
  {
    label: 'Consortium Onboarding Form',
    href: '/consortium-resources/onboarding-form',
  },
  {
    label: 'Consortium Offboarding Form',
    href: '/consortium-resources/consortium-offboarding',
  },
  {
    label: 'Publications and Engagement',
    href: '/consortium-resources/publications',
  },
  {
    label: 'BDC Branding',
    href: '/consortium-resources/bdc-branding',
  },
];

function isActive(href: string | undefined, exact = false) {
  if (!href) return false;
  if (exact) return pathname === href;
  return pathname === href || pathname.startsWith(`${href}/`);
}

function isSectionActive(item: NavItem): boolean {
  if (isActive(item.href, item.exact)) return true;
  return item.children?.some((c) => isSectionActive(c)) ?? false;
}
---

<div>
  <nav aria-label="Secondary navigation" class="bg-gray-10 radius-md padding-y-2">
    <ul class="usa-sidenav">
      {
        nav.map((section) => (
          <li class="usa-sidenav__item">
            {section.href ? (
              <a href={section.href} class={isSectionActive(section) ? "usa-current" : ""}>
                {section.label}
              </a>
            ) : (
              <span class="display-block padding-y-1 padding-x-2 text-bold">
                {section.label}
              </span>
            )}
            {section.children && isSectionActive(section) && (
              <ul class="usa-sidenav__sublist bg-gray-5">
                {section.children.map((child) => (
                  <li class="usa-sidenav__item">
                    {child.href ? (
                      <a href={child.href} class={isSectionActive(child) ? "usa-current" : ""}>
                        {child.label}
                      </a>
                    ) : child.children ? (
                      <details open={isSectionActive(child)}>
                        <summary class="display-block padding-y-1 padding-x-2 text-bold cursor-pointer">
                          {child.label}
                        </summary>
                        <ul class="usa-sidenav__sublist bg-gray-5">
                          {child.children.map((subchild) => (
                            <li class="usa-sidenav__item">
                              <a href={subchild.href} class={isActive(subchild.href) ? "usa-current" : ""}>
                                {subchild.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    ) : (
                      <span class="display-block padding-y-1 padding-x-2">
                        {child.label}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</div>
