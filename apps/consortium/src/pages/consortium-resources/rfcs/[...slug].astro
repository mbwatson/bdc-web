---
import { type CollectionEntry, getCollection } from 'astro:content';
import FileLink from '@components/common/FileLink.astro';
import Directory from '@layouts/Directory.astro';

interface Props {
  entry: CollectionEntry<'rfcs'>;
}

export async function getStaticPaths() {
  const rfcs = await getCollection('rfcs');
  return rfcs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const decode = (s: string) => s.replace(/&amp;/g, '&');
---

<Directory title={decode(entry.data.title)}>
  <div>
    <h1>{decode(entry.data.title)}</h1>

    <p>
      <span class="usa-tag">{entry.data.phase.toUpperCase()}</span>
      {' '}
      <span class={`usa-tag ${entry.data.status === 'closed' ? 'bg-base' : 'bg-success'}`}>
        {entry.data.status === 'closed' ? 'Closed' : 'Open'}
      </span>
    </p>

    {entry.data.description && (
      <p class="text-base">{entry.data.description}</p>
    )}

    {entry.data.url && (
      <div class="margin-y-3">
        <FileLink href={entry.data.url}>{decode(entry.data.title)}</FileLink>
      </div>
    )}

    {entry.data.documents && (
      <ul class="usa-list usa-list--unstyled">
        {entry.data.documents.map((doc) => (
          <li class="margin-y-3">
            <FileLink href={doc.url}>{doc.title}</FileLink>
            {doc.description && (
              <p class="text-base margin-top-1">{doc.description}</p>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
</Directory>
