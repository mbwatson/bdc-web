---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import FileLink from '@components/common/FileLink.astro';
import Directory from '@layouts/Directory.astro';

interface Props {
  entry: CollectionEntry<'meetings'>;
}

export async function getStaticPaths() {
  const all = await getCollection('meetings');
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Directory title={entry.data.title}>
  <div>
    <h1>{entry.data.title}</h1>
    <Content components={{ a: FileLink }} />
  </div>
</Directory>
